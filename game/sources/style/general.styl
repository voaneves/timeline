
*
    box-sizing border-box
    margin 0
    padding 0
    -webkit-tap-highlight-color transparent

button
input
    background none
    color inherit
    border none
    padding 0
    font inherit
    outline inherit

button
    cursor pointer

html
body
.game
.modals
.menu
    position fixed
    top 0
    left 0
    width 100%
    height 100%
    font-family "Nunito", sans-serif
    font-optical-sizing auto
    font-weight 400
    font-style normal
    -webkit-font-smoothing antialiased
    -moz-osx-font-smoothing grayscale
    overflow hidden

.experience
    touch-action none

    .input-filter-wandering &,
    .input-filter-intro &
        cursor grab

        &:active
            cursor grabbing

html
    background radial-gradient(farthest-side at 0 0, #251f2b, #1d1721)
    font-size 20px
    touch-action manipulation // Prevents double tap zoom

    @media only screen and (max-width 520px)
        font-size 18px

    @media only screen and (max-width 440px)
        font-size 16px;

ul
ol
    padding-left 25px

.title
    margin-bottom 0.25em
    font-size 2.5rem
    font-family "Amatic SC", sans-serif
    font-weight 700
    font-style normal

.text
    margin-bottom 0.75em
    font-size 1rem

    a
        color inherit
        text-decoration underline

.text-small
    font-size 0.8rem

.text-danger
    color #ff87a2
    
    .icon
        vertical-align sub

.text-faded
    opacity 0.8

.text-align-right
    text-align right

.text-align-center
    text-align center

.horizontal-group
    display flex
    align-items center
    justify-content center
    gap 10px

    @media only screen and (max-width 520px)
        flex-direction column

    > *
        // margin-right 10px

        // &:last-child
        //     margin-right 0
        
a.button
        display inline-block

.button
    vertical-align top
    padding 0 16px
    height 58px
    line-height 58px
    border-radius 8px
    white-space nowrap
    color inherit
    text-decoration none
    border 1px solid alpha(#ffffff, 0.8)
    color alpha(#ffffff, 0.8)
    cursor default

    @media only screen and (max-width 520px)
        padding 0 13px
        height 50px
        line-height 50px

    @media only screen and (max-width 440px)
        padding 0 10px
        height 45px
        line-height 45px

    &:not(.is-disabled)
        cursor pointer

    &.is-disabled
        border-style dashed

        &.has-tooltip
            cursor help

    &.is-success
        color #d5ff95

    &.is-danger
        color #ff6a7c

    html:not(.is-mode-touch) &:not(.is-disabled):hover
        border 1px solid alpha(#ffffff, 1)
        color alpha(#ffffff, 1)

    .icon
        position relative
        vertical-align middle

        &.icon-audio
            top -2px

        &.icon-restart
            top -2px

        &.icon-flag
            top -1px

        &.icon-controller
            top -1px

.input-group
    display flex
    height 58px

    &.is-message
        width 100%
        margin-top 1.5em

        .input-text
            width calc(100% - 62px * 2)
            padding 0 15px 0 5px

    &.is-name-tag
        .input-text
            width 100px
            font-size 25px
            letter-spacing 8px
            text-transform uppercase
            font-weight 700
            // padding 0 15px 0 5px

            &::placeholder
                letter-spacing 14px
                padding-left 4px

    > *
        border-top 1px solid #555555
        border-bottom 1px solid #555555

    >:first-child
        border-radius 8px 0 0 8px
        border-left 1px solid #555555

    &.is-valide
        button
            cursor pointer
            border-color #ffceca
            color #ffceca

            &.has-icon
                svg
                    *
                        stroke #ffceca

    .input-text
        padding 0 15px 0 5px

    .submit
        border-radius 0 8px 8px 0
        border 1px solid #555555
        cursor default
        color #555555

        &.has-text
            padding 0 20px

        &.has-icon
            width 62px
            padding 0 8px 0 4px

            svg
                *
                    stroke #555555

    .input-flag
        position relative
        width 62px
        font-size 16px

        .flag-button
            position absolute
            top 0
            left 0
            width 100%
            height 100%
            display flex
            justify-content center
            align-items center
            cursor pointer

            &.has-flag
                .flag
                    display block

                svg
                    display none

            .flag
                display none
                width 27px
                height 18px

            html:not(.is-mode-touch) &:hover
                svg
                    *
                        fill #cccccc

            svg
                display block

                *
                    fill #555555

        .flag-select
            display none
            position absolute
            bottom 0
            left 8px
            width 350px
            height 240px
            background radial-gradient(ellipse at top left, #251f2b, #1d1721)
            border-radius 8px 8px 0 0
            border 1px solid #767676
            border-bottom none
            overflow hidden
            white-space nowrap
            z-index 1

            &.is-visible
                display block

            .close-mini
                display flex
                align-items center
                justify-content center
                position absolute
                height 40px
                width 34px
                top 0
                right 0
                opacity 0.65
                cursor pointer

                html:not(.is-mode-touch) &:hover
                    opacity 1

                img
                    position relative
                    top 4px
                    left -3px
            

            .remove
                display flex
                align-items center
                justify-content center
                position absolute
                height 40px
                width 34px
                top 0
                right 30px
                opacity 0.65
                cursor pointer

                html:not(.is-mode-touch) &:hover
                    opacity 1

                img
                    position relative
                    top 3px
            
            .search
                height 40px
                width 100%
                padding 4px 35px 0 10px

            .no-result
                display none
                justify-content center
                align-items center
                position absolute
                top 30px
                bottom 0
                left 0
                right 0
                opacity 0.65
                pointer-events none

                &.is-visible
                    display flex
            
            .choices
                position absolute
                top 40px
                bottom 0
                left 0
                right 0
            
                .scroller
                    position absolute
                    top 0
                    left 0
                    width calc(100% + 20px)
                    height 100%
                    overflow-y scroll
                    overflow-x hidden

                .choice
                    display flex
                    padding 4px 8px
                    cursor pointer

                    html:not(.is-mode-touch) &:hover
                        .label
                            opacity 1

                    .label
                        opacity 0.65

                    .flag
                        margin-right 8px
                        width 27px
                        height 18px

html:not(.is-server-offline) .offline-element
    display none !important

html:not(.is-standalone) .standalone-element
    display none !important

html.is-standalone
    .offline-element
    .js-navigation-item[data-name="whispers"]
    tr.is-server-row
    .circuit-content .reset
        display none !important

.standalone-element
    text-align center
    font-size 0.85em
    opacity 0.6

html:not(.is-server-online) .online-element
    display none !important

.surface-trigger
    display none
    position absolute
    right 0
    top 122px
    height 38px
    min-width 118px
    z-index 9
    -webkit-user-select none
    -moz-user-select none
    user-select none

    html.is-started.is-underwater &
        display block

    html.input-filter-menu &
    html.input-filter-cinematic &
    html.input-filter-intro &
        pointer-events none

    --hover-translate 4px

    html:not(.is-mode-touch) &:hover
        .button-inner
            transform translateX(-4px)

            &::after
                opacity 0.8

            .icon-container
                opacity 1

    .button-inner
        position relative
        display flex
        align-items center
        height 100%
        padding 0 12px 0 14px
        background radial-gradient(ellipse at top right, #1eb8b0, #0a3561)
        transition transform 0.15s 0.15s

        html.input-filter-menu &,
        html.input-filter-modal &,
        html.input-filter-intro &
        html.input-filter-cinematic &
            transform translateX(100%)
            transition-delay 0

        &::after
            content: ''
            display block
            position absolute
            top 3px
            right 0
            bottom 3px
            left 3px
            border 1px solid #ffffff
            border-right none
            opacity 0.35
            transition opacity 0.15s

        .icon-container
            display flex
            align-items center
            gap 6px
            color #ffffff
            font-size 12px
            font-weight 600
            letter-spacing 0.04em
            text-transform uppercase
            opacity 0.88
            transition opacity 0.15s

            .surface-arrow
                font-size 15px
                line-height 1

.underwater-hud
    display none
    position absolute
    top 16px
    left 16px
    z-index 8
    padding 8px 16px
    background linear-gradient(135deg, rgba(6, 36, 62, 0.84), rgba(13, 86, 108, 0.78))
    border 1px solid rgba(139, 238, 255, 0.45)
    box-shadow 0 6px 24px rgba(2, 16, 32, 0.45)
    backdrop-filter blur(6px)
    color #e9faff
    text-align left
    pointer-events none
    -webkit-user-select none
    -moz-user-select none
    user-select none
    transition transform 0.2s, opacity 0.2s

    html.is-started.is-underwater &
        display block

    html.input-filter-menu &,
    html.input-filter-modal &,
    html.input-filter-intro &,
    html.input-filter-cinematic &
        opacity 0
        transform translateY(-16px)

    .uw-status
        font-size 13px
        font-weight 700
        letter-spacing 0.06em
        text-transform uppercase
        color #8beeff

    .uw-meta
        font-size 12px
        font-weight 600
        margin-top 2px
        color #ffffff

    .uw-hint
        font-size 11px
        margin-top 2px
        opacity 0.78
        color #bfefff

    @media only screen and (max-width 640px)
        top 10px
        padding 6px 12px
        max-width calc(100vw - 130px)

        .uw-status
            font-size 11px

        .uw-meta
            font-size 11px

        .uw-hint
            display none

// Pista de corrida removida: ocultar aba Circuit no menu
.js-navigation-item[data-name="circuit"]
    display none !important

// HUD Arcade do Parque das Paixoes
@keyframes parkPop
    0%
        transform translate(-50%, -50%) scale(0.55)
        opacity 0
    25%
        transform translate(-50%, -50%) scale(1.12)
        opacity 1
    100%
        transform translate(-50%, -50%) scale(1)
        opacity 1

@keyframes parkToastIn
    0%
        transform translateX(-50%) translateY(12px) scale(0.85)
        opacity 0
    20%
        transform translateX(-50%) translateY(0) scale(1.06)
        opacity 1
    100%
        transform translateX(-50%) translateY(-4px) scale(1)
        opacity 1

.park-arcade-hud
    position fixed
    top 16px
    left 16px
    z-index 40
    min-width 290px
    width 360px
    max-width calc(100vw - 128px)
    padding 11px 14px 12px
    border-radius 14px
    background rgba(10, 20, 36, 0.88)
    border 1px solid rgba(255, 209, 102, 0.35)
    box-shadow 0 12px 32px rgba(0, 0, 0, 0.45)
    backdrop-filter blur(8px)
    color #f8fafc
    opacity 0
    pointer-events none
    transform translateY(-14px)
    transition opacity 0.25s ease, transform 0.25s ease

    &.is-active
        opacity 1
        pointer-events auto
        transform translateY(0)

    html.input-filter-menu &,
    html.input-filter-modal &,
    html.input-filter-intro &,
    html.input-filter-cinematic &
        opacity 0 !important
        pointer-events none !important

    .park-hud-top
        display flex
        align-items center
        justify-content space-between
        gap 10px
        margin-bottom 8px

    .park-hud-title-wrap
        display flex
        align-items center
        gap 7px
        font-size 14px
        font-weight 800
        letter-spacing 0.04em
        text-transform uppercase
        color #ffd166

    .park-exit-btn
        padding 3px 9px
        border-radius 7px
        font-size 11px
        font-weight 700
        background rgba(255, 255, 255, 0.1)
        color #cbd5e1
        transition background 0.15s

        &:hover
            background rgba(239, 68, 68, 0.35)
            color #fff

    .park-hud-stats
        display grid
        grid-template-columns repeat(4, 1fr)
        gap 6px
        margin-bottom 7px

    .park-stat
        background rgba(255, 255, 255, 0.06)
        border-radius 8px
        padding 5px 6px
        text-align center

    .park-stat-label
        display block
        font-size 9px
        font-weight 700
        letter-spacing 0.06em
        text-transform uppercase
        color #94a3b8

    .park-stat-val
        display block
        font-size 14px
        font-weight 800
        margin-top 1px
        color #ffffff

        &.is-warn
            color #fbbf24

        &.is-crit
            color #f87171

        &.is-hot
            color #38bdf8

    .park-hud-hint
        font-size 11.5px
        line-height 1.3
        color #cbd5e1

    .park-timing-wrap
        display none
        margin-top 9px

        &.is-visible
            display block

    .park-timing-bar
        position relative
        height 22px
        border-radius 11px
        background #1e293b
        border 1px solid rgba(255, 255, 255, 0.18)
        overflow hidden
        cursor pointer

        .zone-good
            position absolute
            top 0
            bottom 0
            background rgba(34, 197, 94, 0.52)

        .zone-perfect
            position absolute
            top 0
            bottom 0
            background rgba(250, 204, 21, 0.88)

        .needle
            position absolute
            top -2px
            bottom -2px
            width 4px
            margin-left -2px
            border-radius 2px
            background #ffffff
            box-shadow 0 0 10px #ffffff

    .park-timing-caption
        margin-top 4px
        font-size 11px
        font-weight 700
        color #fde047
        text-align center

.park-countdown
    position fixed
    top 42%
    left 50%
    z-index 45
    transform translate(-50%, -50%)
    font-size 76px
    font-weight 900
    letter-spacing 0.06em
    color #ffffff
    text-shadow 0 6px 28px rgba(56, 189, 248, 0.7), 0 3px 0 rgba(15, 23, 42, 0.9)
    pointer-events none
    display none

    &.is-active
        display block
        animation parkPop 0.55s ease forwards

    &.is-go
        color #ffd166

.park-toast
    position fixed
    top 86px
    left 50%
    z-index 42
    transform translateX(-50%)
    padding 6px 14px
    border-radius 999px
    background rgba(15, 23, 42, 0.9)
    border 1px solid rgba(255, 209, 102, 0.5)
    font-size 13px
    font-weight 800
    color #fde047
    pointer-events none
    display none

    &.is-active
        display block
        animation parkToastIn 0.28s ease forwards

    &[data-accent="cyan"]
        color #38bdf8
        border-color rgba(56, 189, 248, 0.55)

    &[data-accent="danger"]
        color #fca5a5
        border-color rgba(248, 113, 113, 0.65)

.park-result-card
    position fixed
    bottom 24px
    left 50%
    z-index 44
    transform translateX(-50%) translateY(20px)
    display flex
    align-items center
    gap 14px
    min-width 320px
    max-width calc(100vw - 32px)
    padding 12px 16px
    border-radius 14px
    background rgba(10, 20, 36, 0.92)
    border 1px solid rgba(255, 209, 102, 0.45)
    box-shadow 0 14px 36px rgba(0, 0, 0, 0.5)
    backdrop-filter blur(10px)
    color #f8fafc
    opacity 0
    pointer-events none
    transition opacity 0.25s ease, transform 0.25s ease

    &.is-active
        opacity 1
        pointer-events auto
        transform translateX(-50%) translateY(0)

    .park-res-medal
        font-size 34px
        line-height 1

    .park-res-body
        flex 1

    .park-res-top
        display flex
        align-items center
        gap 8px

    .park-res-title
        font-size 13px
        font-weight 800
        text-transform uppercase
        color #cbd5e1

    .park-res-badge
        padding 2px 7px
        border-radius 999px
        font-size 10px
        font-weight 800
        background rgba(250, 204, 21, 0.22)
        color #fde047

    .park-res-score
        font-size 18px
        font-weight 900
        color #ffffff
        margin-top 2px

    .park-res-meta
        font-size 11px
        color #94a3b8

    .park-res-actions
        display flex
        flex-direction column
        gap 5px

    .park-res-btn
        padding 5px 11px
        border-radius 7px
        font-size 11px
        font-weight 800
        background rgba(255, 255, 255, 0.1)
        color #e2e8f0

        &.is-primary
            background #f59e0b
            color #0f172a

@media only screen and (max-width 640px)
    .park-arcade-hud
        top 10px
        left 10px
        min-width 0
        padding 8px 10px

        .park-hud-stats
            grid-template-columns repeat(2, 1fr)

    .park-result-card
        flex-direction column
        align-items stretch
        text-align center

        .park-res-actions
            flex-direction row
            justify-content center

// Toast visual de manobras e acrobacias
.stunt-toast
    position fixed
    top 132px
    left 50%
    z-index 43
    transform translateX(-50%)
    padding 7px 18px
    border-radius 999px
    background rgba(15, 23, 42, 0.92)
    border 2px solid #fb923c
    box-shadow 0 8px 24px rgba(249, 115, 22, 0.38)
    font-size 15px
    font-weight 900
    letter-spacing 0.05em
    color #fde047
    pointer-events none
    display none

    &.is-active
        display block
        animation parkToastIn 0.3s ease forwards

    &[data-accent="cyan"]
        border-color #22d3ee
        box-shadow 0 8px 24px rgba(34, 211, 238, 0.38)
        color #67e8f9

    html.input-filter-menu &,
    html.input-filter-modal &,
    html.input-filter-intro &,
    html.input-filter-cinematic &
        display none !important



