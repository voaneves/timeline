.circuit-content
    .leaderboard-container
        display flex
        justify-content center
        align-items center
        flex-direction column
        margin-bottom 1.5em

        &.has-no-score
            .no-score
                display block

        .leaderboard
            font-weight 700
            margin-top 20px
            margin-bottom 20px

            tr
                td
                    &:nth-child(1)
                        opacity 0.5
                        padding-right 30px
                        text-align center

                    &:nth-child(2)
                        padding-right 30px
                        
                    &:nth-child(3)
                        padding-right 30px
                        
        .no-score
            margin-top 30px
            display none
            font-weight 700
            
        .reset-time
            font-weight 700

    .racing-buttons
        display none

        &.is-active
            display flex

.medal-icon
    display inline-block
    width 14px
    height 14px
    border-radius 50%
    vertical-align -2px
    background #888
    box-shadow inset 0 0 0 2px #00000033
    visibility hidden

    &.is-gold
        visibility visible
        background radial-gradient(circle at 35% 30%, #fff3a8, #f2b705)

    &.is-silver
        visibility visible
        background radial-gradient(circle at 35% 30%, #ffffff, #aab4bd)

    &.is-bronze
        visibility visible
        background radial-gradient(circle at 35% 30%, #ffd2a1, #b8692c)

.circuit-content
    .button-clear-records
        display block
        margin 0 auto 1em
        padding 4px 10px
        background none
        border none
        color inherit
        font inherit
        font-size 0.85em
        opacity 0.6
        text-decoration underline
        cursor pointer

        html:not(.is-mode-touch) &:hover
            opacity 1

    .leaderboard
        .medal-icon
            margin-left 8px

